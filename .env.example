# Copie este arquivo para .env.local e preencha com os valores do seu projeto
# Supabase. Nunca coloque valores reais aqui: este arquivo vai para o Git.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → botão "Connect" → Connection String
# Pooler de transação (porta 6543): usado pelo app
DATABASE_URL=
# Pooler de sessão (porta 5432): usado pelas migrations (drizzle-kit)
DATABASE_URL_MIGRATIONS=
